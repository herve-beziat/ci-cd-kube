{
  "name": "pocketman",
  "version": "1.0.3",
  "description": "Testeur d'API REST léger, style Postman",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prestart": "electron-rebuild -f -w better-sqlite3",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.herve-beziat.pocketman",
    "productName": "Pocketman",
    "files": [
      "main.js",
      "preload.js",
      "frontend/**/*",
      "backend/**/*",
      "db/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
